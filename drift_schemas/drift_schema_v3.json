  "fixed_sql": [
    {
      "name": "users",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"users\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"username\" TEXT NOT NULL UNIQUE, \"password_hash\" TEXT NOT NULL, \"role\" TEXT NOT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"last_sign_in_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entries\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"receipt_no\" INTEGER NOT NULL, \"entry_date\" TEXT NOT NULL, \"name\" TEXT NOT NULL DEFAULT '', \"purpose\" TEXT NULL, \"approver_name\" TEXT NULL, \"amount\" INTEGER NOT NULL, \"address\" TEXT NULL, \"status\" TEXT NOT NULL DEFAULT 'active', \"cancel_reason\" TEXT NULL, \"created_by\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"edited_by\" TEXT NULL, \"edited_at\" INTEGER NULL, \"cancelled_by\" TEXT NULL, \"cancelled_at\" INTEGER NULL, \"device_id\" TEXT NOT NULL, \"synced\" INTEGER NOT NULL DEFAULT 0 CHECK (\"synced\" IN (0, 1)), \"synced_at\" INTEGER NULL, \"is_duplicate\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_duplicate\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "photos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"photos\" (\"id\" TEXT NOT NULL, \"entry_id\" TEXT NOT NULL REFERENCES entries (id), \"file_name\" TEXT NOT NULL, \"label\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"removed_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "approvers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"approvers\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "sync_log",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_log\" (\"id\" TEXT NOT NULL, \"phone_name\" TEXT NOT NULL, \"at\" INTEGER NOT NULL, \"entries_received\" INTEGER NOT NULL, \"photos_received\" INTEGER NOT NULL, \"duplicates\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "drive_uploaded_photos",
      "sql": [
